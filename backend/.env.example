# ─── Base de datos (Neon / Railway) ───────────────────────────
# Connection string de Postgres. Neon la muestra en el dashboard.
DATABASE_URL="postgresql://usuario:contraseña@host/basededatos?sslmode=require"

# ─── Sesiones ─────────────────────────────────────────────────
# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=""

# ─── Entorno ──────────────────────────────────────────────────
# En local dejalo en development; en Render poné production.
NODE_ENV="development"
PORT=3000

# URL del frontend (para CORS)
FRONTEND_URL="http://localhost:5173"
